# --- WhatsApp Business Cloud API (Meta, official) ---
# Permanent token from a Meta System User (Business Settings -> System Users -> Generate Token)
# with whatsapp_business_messaging + whatsapp_business_management scopes.
# NOT the 24-hour temporary token from the app dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
# Meta app id (identifier, not a secret) — used for app-level webhook subscription calls
WHATSAPP_APP_ID=

# --- Database (source of truth) ---
# Production: Supabase shared pooler (percent-encode special chars in the password, e.g. @ -> %40)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local dev default matches docker-compose.yml:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/airco_agent

# --- Server ---
PORT=3100

# --- Security: shared secret for the (stubbed) PMS/booking webhook ---
BOOKING_WEBHOOK_SECRET=

# --- Dashboard admin token (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# Required to use /admin. Fail-closed: admin routes return 503 if unset.
ADMIN_TOKEN=

# --- Message policy ---
PROACTIVE_DAILY_CAP=2

# --- Milestone smoke test ---
TEST_RECIPIENT_NUMBER=

# --- Local dry-run mode for scripts/demo (never enable in production) ---
# WHATSAPP_DRY_RUN=true

# --- Review link used in the review_request template (must match the approved template) ---
REVIEW_URL=

# --- TEST-ONLY: remap template sends to Meta's pre-approved test templates ---
# Meta test WhatsApp Business Accounts auto-reject custom template submissions,
# so on a test WABA this remaps sends to Meta's own approved sample templates.
# NEVER set in production.
# TEMPLATE_OVERRIDES={"booking_confirmation":{"name":"jaspers_market_order_confirmation_v1","vars":["guest_name","guest_id","check_in"]}}
